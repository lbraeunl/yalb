{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-openmp-release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-cpu-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "Kokkos_ENABLE_CUDA": "OFF",
        "Kokkos_ENABLE_OPENMP": "ON",
        "Kokkos_ENABLE_SERIAL": "ON"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA Release (GTX 1070)",
      "description": "Build Kokkos with the CUDA backend for the GTX 1070 (Pascal, compute capability 6.1).",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "Kokkos_ENABLE_CUDA": "ON",
        "Kokkos_ARCH_PASCAL61": "ON",
        "Kokkos_ENABLE_SERIAL": "ON"
      }
    },
    {
      "name": "a100-release",
      "displayName": "CUDA Release (NVIDIA A100)",
      "description": "Build Kokkos with CUDA for an NVIDIA A100 (Ampere, compute capability 8.0).",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-a100",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "Kokkos_ENABLE_CUDA": "ON",
        "Kokkos_ARCH_AMPERE80": "ON",
        "Kokkos_ENABLE_SERIAL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release"
    },
    {
      "name": "a100-release",
      "configurePreset": "a100-release"
    }
  ]
}
